      "parameters": {
        "jsCode": "const fields = [\n  \"metadata.source_type\",\n  \"metadata.source_id\",\n  \"metadata.transaction_id\"\n];\n\nreturn fields.map(field => ({\n  json: {\n    field_name: field,\n    field_schema: \"keyword\"\n  }\n}));"
