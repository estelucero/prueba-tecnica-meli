    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst cases = $(\"Normalizar Casos Históricos\").all();\nconst { v5: uuidv5 } = require('uuid');\nconst NAMESPACE = '6ba7b810-9dad-11d1-80b4-00c04fd430c8';\n\nif (responses.length !== cases.length) {\n  throw new Error(\"Cantidad de embeddings y casos diferente\");\n}\n\nconst points = responses.map((item, index) => {\n  const historicalCase = cases[index].json;\n  const vector = item.json.data?.[0]?.embedding;\n\n  if (!Array.isArray(vector) || vector.length !== 1536) {\n    throw new Error(\n      `Embedding inválido: ${historicalCase.source_id}`\n    );\n  }\n\n  return {\n    id: uuidv5(`${historicalCase.source_type}:${historicalCase.source_id}`, NAMESPACE),\n    vector,\n    payload: {\n      page_content: historicalCase.text_for_embedding,\n      metadata: {\n        source_type: historicalCase.source_type,\n        source_id: historicalCase.source_id,\n        ...historicalCase.data\n      }\n    }\n  };\n});\n\nreturn [{ json: { points } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        -160
      ],
      "id": "a029581f-b42b-4185-a4ec-95e6e51a9083",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const row = item.json;\n\n  const caseId = String(row[\"ID Caso\"]);\n  const transactionId = String(row[\"ID Transacción\"]);\n\n  return {\n    json: {\n      source_type: \"historical_case\",\n      source_id: caseId,\n      transaction_id: transactionId,\n\n      text_for_embedding: [\n        `Motivo del contracargo: ${row.Motivo}`,\n        `Observaciones: ${row.Observaciones ?? \"\"}`\n      ].join(\"\\n\"),\n\n      data: {\n        transaction_id: transactionId,\n        reason: row.Motivo,\n        resolution: row.Resolución,\n        resolution_days: Number(row[\"Tiempo Resolución (días)\"]),\n        analyst: row.Analista,\n        observations: row.Observaciones ?? null,\n        opened_at: row[\"Fecha Apertura\"],\n        closed_at: row[\"Fecha Cierre\"]\n      }\n    }\n  };\n});"
      },
