    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const row = item.json;\n\n  // Extraemos el código de política, por ejemplo POL-FRD-001\n  const policyCode = String(row[\"Política\"] ?? \"\")\n    .match(/POL-[A-Z]+-\\d+/)?.[0] ?? null;\n\n  return {\n    json: {\n      source_type: \"internal_policy\",\n      source_id: policyCode ?? String(row[\"Política\"]),\n      text_for_embedding: [\n        `Categoría: ${row[\"Categoría\"]}`,\n        `Política: ${row[\"Política\"].split(\"—\")[1]}`,\n        `Descripción: ${row[\"Descripción\"]}`,\n      ].join(\"\\n\"),\n      data: {\n        category: row[\"Categoría\"],\n        policy: row[\"Política\"],\n        policy_code: policyCode,\n        description: row[\"Descripción\"],\n        reference: row[\"Referencia\"]\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        304
      ],
      "id": "2f7c5632-eb87-40af-9355-48f18fc84b15",
      "name": "Normalizar Politicas"
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst { v5: uuidv5 } = require('uuid');\nconst NAMESPACE = '6ba7b810-9dad-11d1-80b4-00c04fd430c8';\n\nconst points = responses.map((item, index) => {\n  const policy = $(\"Normalizar Politicas\").itemMatching(index).json;\n  const vector = item.json.data?.[0]?.embedding;\n\n  if (!Array.isArray(vector) || vector.length !== 1536) {\n    throw new Error(`Embedding inválido para ${policy.source_id}`);\n  }\n\n  return {\n    id: uuidv5(`${policy.source_type}:${policy.source_id}`, NAMESPACE),\n    vector,\n    payload: {\n      page_content: policy.text_for_embedding,\n      metadata: {\n        source_type: policy.source_type,\n        source_id: policy.source_id,\n        ...policy.data\n      }\n    }\n  };\n});\n\nreturn [{ json: { points } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
